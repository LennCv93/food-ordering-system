            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "url": {
              "raw": "{{userServiceUrl}}/api/v1/users/me",
              "host": ["{{userServiceUrl}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Perfil del usuario autenticado (USER o ADMIN)."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "List Users (Admin)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "url": {
