                  "pm.test('delivery is ASSIGNED', () => pm.expect(json.status).to.eql('ASSIGNED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "url": {
              "raw": "{{deliveryServiceUrl}}/api/v1/deliveries/order/{{orderId}}",
              "host": ["{{deliveryServiceUrl}}"],
              "path": ["api", "v1", "deliveries", "order", "{{orderId}}"]
            },
            "description": "Se crea automáticamente en ASSIGNED al consumir payment.completed. Nota: a diferencia de Orders/Payments, este endpoint no restringe por dueño del pedido, solo por rol (USER o ADMIN) — ver food-ordering-architecture-overview.md, sección 4.5."
          }
        },
        {
          "name": "Update Delivery Status (Admin) - IN_TRANSIT",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"IN_TRANSIT\"\n}" },
            "url": {
              "raw": "{{deliveryServiceUrl}}/api/v1/deliveries/{{deliveryId}}/status",
              "host": ["{{deliveryServiceUrl}}"],
              "path": ["api", "v1", "deliveries", "{{deliveryId}}", "status"]
            },
            "description": "Solo ADMIN. Simula que el repartidor recogió el pedido. order-service reflejará esto como IN_DELIVERY."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('delivery is IN_TRANSIT', () => pm.expect(json.status).to.eql('IN_TRANSIT'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Delivery Status (Admin) - DELIVERED",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"DELIVERED\"\n}" },
            "url": {
              "raw": "{{deliveryServiceUrl}}/api/v1/deliveries/{{deliveryId}}/status",
              "host": ["{{deliveryServiceUrl}}"],
              "path": ["api", "v1", "deliveries", "{{deliveryId}}", "status"]
            },
            "description": "Solo ADMIN. Cierra el flujo end-to-end. order-service reflejará esto como DELIVERED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('delivery is DELIVERED', () => pm.expect(json.status).to.eql('DELIVERED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Order By Id (final state)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "url": {
              "raw": "{{orderServiceUrl}}/api/v1/orders/{{orderId}}",
              "host": ["{{orderServiceUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}"]
            },
            "description": "Confirma el cierre del flujo end-to-end: el pedido debe reflejar status DELIVERED tras los eventos de order.created -> payment.completed -> delivery.status-changed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('order is DELIVERED', () => pm.expect(json.status).to.eql('DELIVERED'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
