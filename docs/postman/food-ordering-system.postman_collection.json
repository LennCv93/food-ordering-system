          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "Get User By Id (Admin)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "url": {
              "raw": "{{userServiceUrl}}/api/v1/users/1",
              "host": ["{{userServiceUrl}}"],
              "path": ["api", "v1", "users", "1"]
            },
            "description": "Solo ADMIN. El usuario id=1 es el admin sembrado."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Catalog",
      "item": [
