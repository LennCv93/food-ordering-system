          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lomo Saltado\",\n  \"description\": \"Con papas y arroz\",\n  \"price\": 28.00,\n  \"category\": \"MAIN\",\n  \"stockQuantity\": 20\n}"
            },
            "url": {
              "raw": "{{catalogServiceUrl}}/api/v1/products",
              "host": ["{{catalogServiceUrl}}"],
              "path": ["api", "v1", "products"]
            },
            "description": "Solo ADMIN. Guarda el id creado en {{productId}}, usado por Orders."
          }
        },
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "url": {
              "raw": "{{catalogServiceUrl}}/api/v1/products",
              "host": ["{{catalogServiceUrl}}"],
              "path": ["api", "v1", "products"]
            },
            "description": "USER o ADMIN. Soporta query params opcionales ?category= y ?available=."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "Get Product By Id",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "url": {
              "raw": "{{catalogServiceUrl}}/api/v1/products/{{productId}}",
              "host": ["{{catalogServiceUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "Update Product (Admin)",
          "request": {
            "method": "PUT",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lomo Saltado\",\n  \"description\": \"Con papas y arroz (porción grande)\",\n  \"price\": 30.00,\n  \"category\": \"MAIN\",\n  \"available\": true,\n  \"stockQuantity\": 15\n}"
            },
            "url": {
              "raw": "{{catalogServiceUrl}}/api/v1/products/{{productId}}",
              "host": ["{{catalogServiceUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            },
            "description": "Solo ADMIN. Reemplazo completo del producto."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Orders",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('orderId', json.id);",
                  "pm.test('order is PENDING_PAYMENT', () => pm.expect(json.status).to.eql('PENDING_PAYMENT'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deliveryAddress\": \"Av. Postman 123\",\n  \"items\": [\n    { \"productId\": {{productId}}, \"quantity\": 1 }\n  ]\n}"
            },
            "url": {
              "raw": "{{orderServiceUrl}}/api/v1/orders",
              "host": ["{{orderServiceUrl}}"],
              "path": ["api", "v1", "orders"]
            },
            "description": "USER. Valida el producto contra catalog-service (síncrono, con Retry + Circuit Breaker) y publica order.created. Guarda el id en {{orderId}}, usado por el resto del flujo (pago y entrega)."
          }
        },
        {
          "name": "Get Order By Id",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "url": {
              "raw": "{{orderServiceUrl}}/api/v1/orders/{{orderId}}",
              "host": ["{{orderServiceUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "url": {
              "raw": "{{orderServiceUrl}}/api/v1/orders",
              "host": ["{{orderServiceUrl}}"],
              "path": ["api", "v1", "orders"]
            },
            "description": "USER ve solo sus pedidos; ADMIN ve todos (probar también con {{adminToken}})."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "Create Order For Cancellation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('cancelOrderId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deliveryAddress\": \"Av. Postman Cancel Test 456\",\n  \"items\": [\n    { \"productId\": {{productId}}, \"quantity\": 1 }\n  ]\n}"
            },
            "url": {
              "raw": "{{orderServiceUrl}}/api/v1/orders",
              "host": ["{{orderServiceUrl}}"],
              "path": ["api", "v1", "orders"]
            },
            "description": "Pedido dedicado a demostrar la cancelación, separado de {{orderId}} para no romper el flujo de pago/entrega que sigue después."
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "url": {
              "raw": "{{orderServiceUrl}}/api/v1/orders/{{cancelOrderId}}/cancel",
              "host": ["{{orderServiceUrl}}"],
              "path": ["api", "v1", "orders", "{{cancelOrderId}}", "cancel"]
            },
            "description": "Cancela el pedido creado en el paso anterior (aún no pagado, así que la cancelación es válida). Sobre un pedido ya PAID esto respondería 409."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('order is CANCELLED', () => pm.expect(json.status).to.eql('CANCELLED'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Payments",
      "item": [
        {
          "name": "Get Payment By Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('paymentId', json.id);",
                  "pm.test('payment is PENDING', () => pm.expect(json.status).to.eql('PENDING'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "url": {
              "raw": "{{paymentServiceUrl}}/api/v1/payments/order/{{orderId}}",
              "host": ["{{paymentServiceUrl}}"],
              "path": ["api", "v1", "payments", "order", "{{orderId}}"]
            },
            "description": "El pago se crea automáticamente en PENDING al consumir order.created (puede tardar uno o dos segundos tras crear el pedido)."
          }
        },
        {
          "name": "Pay Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('payment resolved to APPROVED or REJECTED', () => pm.expect(json.status).to.be.oneOf(['APPROVED', 'REJECTED']));",
                  "",
                  "const maxRetries = 5;",
                  "let attempts = parseInt(pm.collectionVariables.get('payRetryCount') || '0');",
                  "",
                  "if (json.status === 'REJECTED' && attempts < maxRetries) {",
                  "  attempts += 1;",
                  "  pm.collectionVariables.set('payRetryCount', String(attempts));",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('orderServiceUrl') + '/api/v1/orders',",
                  "    method: 'POST',",
                  "    header: {",
                  "      'Content-Type': 'application/json',",
                  "      'Authorization': 'Bearer ' + pm.collectionVariables.get('userToken')",
                  "    },",
                  "    body: {",
                  "      mode: 'raw',",
                  "      raw: JSON.stringify({",
                  "        deliveryAddress: 'Av. Postman Retry Flow',",
                  "        items: [{ productId: parseInt(pm.collectionVariables.get('productId')), quantity: 1 }]",
                  "      })",
                  "    }",
                  "  }, function (err, response) {",
                  "    const order = response.json();",
                  "    pm.collectionVariables.set('orderId', order.id);",
                  "    pm.execution.setNextRequest('Pay Order');",
                  "  });",
                  "} else {",
                  "  pm.collectionVariables.set('payRetryCount', '0');",
                  "  pm.collectionVariables.set('paymentId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"CREDIT_CARD\"\n}"
            },
            "url": {
              "raw": "{{paymentServiceUrl}}/api/v1/payments/order/{{orderId}}/pay",
              "host": ["{{paymentServiceUrl}}"],
              "path": ["api", "v1", "payments", "order", "{{orderId}}", "pay"]
            },
            "description": "Simula el pago (resultado aleatorio, ~80% APRROVED por defecto). Si sale REJECTED, el script de test crea un pedido nuevo automáticamente y reintenta este mismo request (hasta 5 veces) para que el flujo llegue a Deliveries con un pago aprobado."
          }
        }
      ]
    },
    {
      "name": "6. Deliveries",
      "item": [
        {
          "name": "Get Delivery By Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
