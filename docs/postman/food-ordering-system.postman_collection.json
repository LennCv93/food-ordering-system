{
  "info": {
    "name": "Food Ordering System",
    "description": "Colección end-to-end del sistema de pedidos de comida. Las carpetas están ordenadas siguiendo el flujo real de un pedido: Auth -> Users -> Catalog -> Orders -> Payments -> Deliveries. Cada request que produce un dato necesario para las siguientes (tokens, ids) lo guarda automáticamente en variables de colección mediante scripts de Test, por lo que toda la colección puede correrse de punta a punta con el Collection Runner sin editar nada a mano.\n\nUsuario admin sembrado: admin@foodorder.com / Admin123!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "userServiceUrl", "value": "http://localhost:8081" },
    { "key": "catalogServiceUrl", "value": "http://localhost:8082" },
    { "key": "orderServiceUrl", "value": "http://localhost:8083" },
    { "key": "paymentServiceUrl", "value": "http://localhost:8084" },
    { "key": "deliveryServiceUrl", "value": "http://localhost:8085" },
    { "key": "userEmail", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "userToken", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "cancelOrderId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "deliveryId", "value": "" },
    { "key": "payRetryCount", "value": "0" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('userEmail', 'user.' + Date.now() + '@foodorder.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('role is USER', () => pm.expect(json.role).to.eql('USER'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Flow\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"Test123!\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/api/v1/auth/register",
              "host": ["{{userServiceUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Registra un usuario nuevo con rol USER. El email se genera dinámicamente (pre-request script) para poder correr la colección varias veces sin chocar con el uniq constraint de email."
          }
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', json.token);",
                  "pm.test('token present', () => pm.expect(json.token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@foodorder.com\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/api/v1/auth/login",
              "host": ["{{userServiceUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Login con el usuario ADMIN sembrado (V2__seed_admin_user.sql). Guarda el JWT en {{adminToken}}."
          }
        },
        {
          "name": "Login (User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('userToken', json.token);",
                  "pm.test('token present', () => pm.expect(json.token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"Test123!\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/api/v1/auth/login",
              "host": ["{{userServiceUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Login con el usuario recién registrado. Guarda el JWT en {{userToken}}, usado por el resto del flujo (crear pedido, pagar, etc.)."
          }
        }
      ]
    },
    {
      "name": "2. Users",
      "item": [
