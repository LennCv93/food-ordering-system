{
  "title": "Food Ordering System - Overview",
  "uid": "food-ordering-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 latency by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Catalog circuit breaker state (order-service)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state{name=\"catalogService\", state=\"closed\"}",
          "legendFormat": "closed",
          "refId": "A"
        },
        {
          "expr": "resilience4j_circuitbreaker_state{name=\"catalogService\", state=\"open\"}",
          "legendFormat": "open",
          "refId": "B"
        },
        {
          "expr": "resilience4j_circuitbreaker_state{name=\"catalogService\", state=\"half_open\"}",
          "legendFormat": "half_open",
          "refId": "C"
        }
      ]
    }
  ]
}
